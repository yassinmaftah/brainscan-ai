# BrainScan AI Environment Configuration Example
# Copy this file to .env before running if custom configuration is needed

# Server & Container Ports
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
JUPYTER_PORT=8888

# Model & Inference Paths
MODEL_PATH=/app/models/best_model.h5
CLASS_NAMES_PATH=/app/models/class_names.json
CONFIDENCE_THRESHOLD=0.70

# TensorFlow Runtime Optimizations
TF_ENABLE_ONEDNN_OPTS=0
